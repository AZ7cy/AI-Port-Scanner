# Store text files with LF line endings in the repository. Git converts them
# to the platform's line endings on checkout.
* text=auto

# Windows batch files need CRLF line endings to run reliably.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never convert line endings or diff as text.
*.ico binary
*.png binary
*.jpg binary
*.exe binary

# Count the PyInstaller spec file as Python in GitHub's language statistics.
*.spec linguist-language=Python
